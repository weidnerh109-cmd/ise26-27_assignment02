#!/bin/sh

# Run from the repository root so Gradle finds the build files.
cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v gradle >/dev/null 2>&1; then
    gradle ktlintCheck
    status=$?
elif command -v mise >/dev/null 2>&1; then
    mise exec -- gradle ktlintCheck
    status=$?
else
    echo "pre-commit: neither gradle nor mise found, cannot run ktlintCheck." >&2
    exit 1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: ktlintCheck failed, commit aborted." >&2
    echo "pre-commit: fix the reported style problems and commit again." >&2
    exit 1
fi

exit 0
